# Copie este arquivo para .env e ajuste conforme o ambiente
ONDETEM_HOST=127.0.0.1
ONDETEM_PORT=8001
ONDETEM_READONLY=0
ONDETEM_HTTPS=0

# Banco PostgreSQL na nuvem (Neon, Supabase ou Render).
# DATABASE_URL=postgresql://usuario:senha@ep-seu-host.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Armazenamento permanente de fotos na nuvem (Cloudinary - grátis sem cartão).
# CLOUDINARY_CLOUD_NAME=seu_cloud_name
# CLOUDINARY_API_KEY=sua_api_key
# CLOUDINARY_API_SECRET=seu_api_secret

# Envio de e-mails de recuperação de senha (Resend - grátis até 3.000 e-mails/mês).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# MAIL_FROM=OndeTem Manaus <onboarding@resend.dev>

# E-mails autorizados a acessar /admin (separados por vírgula)
# ADMIN_EMAILS=seu_email@gmail.com

# Proteção anti-bot Cloudflare Turnstile (opcional - grátis).
# Se vazio, o OndeTem ativa automaticamente o desafio anti-bot assinado + honeypot.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
