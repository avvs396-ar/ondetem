# Copie este arquivo para .env e ajuste conforme o ambiente
ONDETEM_HOST=127.0.0.1
ONDETEM_PORT=8001
ONDETEM_READONLY=0
ONDETEM_HTTPS=0

# Banco PostgreSQL na nuvem (Neon, Supabase ou Render).
# Deixe comentado para usar SQLite local automaticamente.
# DATABASE_URL=postgresql://usuario:senha@ep-seu-host.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Armazenamento permanente de fotos na nuvem (Cloudinary - grátis sem cartão).
# Deixe comentado para salvar localmente em static/uploads/.
# CLOUDINARY_CLOUD_NAME=seu_cloud_name
# CLOUDINARY_API_KEY=sua_api_key
# CLOUDINARY_API_SECRET=seu_api_secret
