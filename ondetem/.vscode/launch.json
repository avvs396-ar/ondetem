{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OndeTem: FastAPI Dev (Auto-Reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["ondetem.web:app", "--host", "127.0.0.1", "--port", "8001", "--reload"],
      "console": "integratedTerminal"
    },
    {
      "name": "OndeTem: Modo Demonstração (Somente Leitura)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["ondetem.web:app", "--host", "127.0.0.1", "--port", "8001"],
      "console": "integratedTerminal",
      "env": {
        "ONDETEM_READONLY": "1"
      }
    }
  ]
}
